{
  "schemaVersion": 1,
  "id": "enderskills",
  "version": "${version}",
  "name": "Ender Skills",
  "description": "Skills from the End: unlock Defense, Mobility and Offense skill trees at the altar. Fabric 1.21.11 port of Ender Skills (with Better Hurt Timer built in).",
  "authors": ["Arekkuusu", "cybercat5555", "PandizeYT (original mod)", "AH Felix (port)"],
  "contact": {
    "sources": "https://github.com/heytorfelix71-code/EndersSkills-1.21.11"
  },
  "license": "MIT",
  "icon": "assets/enderskills/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["dev.enderskills.EnderSkills"],
    "client": ["dev.enderskills.client.EnderSkillsClient"],
    "modmenu": ["dev.enderskills.client.config.ModMenuIntegration"]
  },
  "mixins": [
    "enderskills.mixins.json",
    {
      "config": "enderskills.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.18.2",
    "minecraft": "~1.21.11",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*",
    "yet_another_config_lib_v3": "*",
    "c2me": "*",
    "chunky": "*",
    "modernfix": "*",
    "voxy": "*"
  }
}
